import { CheckCircle2, Clock3, XCircle, RotateCcw, MinusCircle } from 'lucide-react';

type ApprovalRow = {
  id: string;
  approval_cycle: number;
  approver_user_id: string;
  outcome: string;
  approver_name: string | null;
  decided_at: string | null;
};

type Props = {
  rows: ApprovalRow[];
  directory: Record<string, { name: string; role: string }>;
  currentUserId: string;
  versionNumber: number | null;
  cycle: number;
};

const statuses = {
  approved: { label: 'Approved', icon: CheckCircle2, color: '#15803d' },
  pending: { label: 'Pending', icon: Clock3, color: '#a16207' },
  rejected: { label: 'Rejected', icon: XCircle, color: '#b91c1c' },
  changes_requested: { label: 'Changes requested', icon: RotateCcw, color: '#a16207' },
  withdrawn: { label: 'Withdrawn', icon: MinusCircle, color: '#64748b' },
} as const;

export default function DecisionApprovalProgress({ rows, directory, currentUserId, versionNumber, cycle }: Props) {
  const approved = rows.filter(row => row.outcome === 'approved').length;
  const pending = rows.filter(row => row.outcome === 'pending').length;
  const progress = rows.length ? Math.round(100 * approved / rows.length) : 0;
  return (
    <section aria-label="Multi-approver progress" className="rounded-lg p-3 space-y-3" style={{ border: '1px solid var(--app-border)' }}>
      <div className="flex items-center justify-between gap-2 flex-wrap">
        <h3 className="text-sm font-semibold">Multi-approver workflow</h3>
        <span className="text-xs" style={{ color: 'var(--app-text-secondary)' }}>{approved} of {rows.length} approved</span>
      </div>
      <div role="progressbar" aria-label="Approval completion" aria-valuemin={0} aria-valuemax={100} aria-valuenow={progress}
        className="h-2 rounded-full overflow-hidden" style={{ background: 'var(--app-border)' }}>
        <div className="h-full bg-green-600" style={{ width: `${progress}%` }} />
      </div>
      <p className="text-xs" style={{ color: 'var(--app-text-secondary)' }}>
        {pending} pending · Version {versionNumber ?? 'unknown'} · Cycle {cycle}
      </p>
      <ul className="space-y-2">
        {rows.map(row => {
          const state = statuses[row.outcome as keyof typeof statuses] ?? statuses.pending;
          const Icon = state.icon;
          const displayName = row.approver_name || directory[row.approver_user_id]?.name || 'Workspace approver';
          return (
            <li key={row.id} className="flex items-center justify-between gap-3 text-xs py-1" style={{ borderBottom: '1px solid var(--app-border)' }}>
              <div>
                <span className="font-medium">{displayName}{row.approver_user_id === currentUserId ? ' (you)' : ''}</span>
                {row.decided_at && <p style={{ color: 'var(--app-text-muted)' }}>{new Date(row.decided_at).toLocaleString()}</p>}
              </div>
              <span className="flex items-center gap-1 font-semibold" style={{ color: state.color }}><Icon className="w-3.5 h-3.5" />{state.label}</span>
            </li>
          );
        })}
      </ul>
      <p className="text-xs" style={{ color: 'var(--app-text-muted)' }}>Every assigned approver must approve the same decision version.</p>
    </section>
  );
}
