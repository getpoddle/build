# Client-side environment variables (prefixed with VITE_ to be exposed to the browser)
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here
VITE_SUPABASE_URL=your_supabase_url_here

# Slack integration (required to enable the Connect Slack button in workspace settings)
VITE_SLACK_CLIENT_ID=your_slack_app_client_id_here

# PostHog product analytics (optional)
VITE_POSTHOG_KEY=phc_your_project_key_here
VITE_POSTHOG_HOST=https://eu.i.posthog.com
